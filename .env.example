NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
REC_URL=http://localhost:8000
POSTGRES_USER=pcs_user
POSTGRES_PASSWORD=pcs_pass
POSTGRES_DB=pcs_db
DATABASE_URL=postgresql://pcs_user:pcs_pass@db:5432/pcs_db
# Optional: signiert Cookies (Sitzungstoken ist ohnehin zufällig + nur als Hash in der DB)
COOKIE_SECRET=dev-secret-change-me
# Erlaubte Herkunft(en) für Browser-Anfragen (CORS + CSRF-Prüfung); Komma-getrennt
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Vertrauenswürdige Proxy-Adressen für X-Forwarded-For (Rate-Limit pro echter
# Client-IP). "0" = gar keinem Proxy-Header vertrauen (nur ohne Proxy sinnvoll).
TRUST_PROXY=uniquelocal,loopback,linklocal
TCGDEX_LANG=de
TCGDEX_BASE_URL=https://api.tcgdex.net/v2
REF_CACHE_DIR=/app/data/ref_cache
UPLOADS_DIR=/app/data/uploads
