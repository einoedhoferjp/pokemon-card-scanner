# Vorlage fuer den Betrieb. Kopieren und ausfuellen:
#
#   cp .env.production.example .env.production
#   # Werte setzen (siehe unten), dann:
#   docker compose --env-file .env.production up -d --build
#
# WICHTIG: .env.production enthaelt Geheimnisse und darf nicht weitergegeben
# oder in ein Repository eingecheckt werden.

# --- Domain und TLS -------------------------------------------------------

# Hostname der Installation. Der DNS-A-Record muss auf den Server zeigen.
# Fuer lokale Tests ohne Domain: localhost (dann PCS_TLS_MODE=internal)
PCS_DOMAIN=scanner.example.org

# "internal" = eigene CA von Caddy: funktioniert ohne oeffentliche Domain und
#              ohne Ports 80/443, der Browser warnt aber vor dem Zertifikat
#              (siehe DEPLOYMENT.md, Abschnitt "Eigene CA").
# dein@mail.de = Let's Encrypt: das Zertifikat ist vertrauenswuerdig, braucht
#              aber eine oeffentliche Domain und die Ports 80 + 443.
PCS_TLS_MODE=internal

# --- Datenbank ------------------------------------------------------------

POSTGRES_USER=pcs_user
POSTGRES_DB=pcs_db

# Passwort erzeugen:  openssl rand -base64 24
POSTGRES_PASSWORD=bitte-aendern

# --- API ------------------------------------------------------------------

# Schluessel zum Signieren der Cookies:  openssl rand -base64 32
COOKIE_SECRET=bitte-aendern

# Vertrauenswuerdige Proxy-Adressen fuer X-Forwarded-For. Die API zaehlt
# ihre Rate-Limits pro echter Client-IP - das setzt voraus, dass die API nur
# ueber den Caddy erreichbar ist (siehe DEPLOYMENT.md, Abschnitt 9).
# "0" schaltet das Vertrauen ganz ab.
TRUST_PROXY=uniquelocal,loopback,linklocal

# --- Rechte im Datenverzeichnis ------------------------------------------

# UID/GID des Host-Nutzers, dem ./data gehoert (Uploads bleiben so zugaenglich).
# Ermitteln mit: id -u  /  id -g
PUID=1000
PGID=1000
